# ============================================================
# Digital Developers — Environment Variables
# Copy this file to `.env.local` and fill in your values.
# ============================================================

# Supabase project credentials (https://supabase.com → your project → Settings → API)
# Leave empty to run the site with WhatsApp-only contact form + demo-mode admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site URL — used for canonical links, OG tags and sitemap.
# Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=
